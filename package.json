{
  "name": "kisuke.vim",
  "version": "0.3.0",
  "description": "Basic AI integration for Vim",
  "repository": "git@github.com:dorukozerr/kisuke.vim.git",
  "author": "Doruk Özer <dorukozer@protonmail.com>",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "format": "prettier --write src",
    "lint": "eslint --fix src",
    "type-check": "tsc --noEmit --pretty",
    "precommit": "pnpm run format && pnpm run lint && pnpm run type-check",
    "build": "tsup --format esm",
    "watch": "tsup --watch"
  },
  "license": "MIT",
  "private": false,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "eslint": "^10.4.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.83",
    "@ai-sdk/google": "^3.0.81",
    "@ai-sdk/mcp": "^1.0.48",
    "@ai-sdk/openai": "^3.0.70",
    "@ai-sdk/xai": "^3.0.94",
    "@langfuse/otel": "^5.4.1",
    "@langfuse/tracing": "^5.4.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api-logs": "^0.219.0",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/instrumentation": "^0.219.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@vercel/otel": "^2.1.3",
    "ai": "^6.0.202",
    "ai-sdk-ollama": "^3.8.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "langfuse-vercel": "^3.38.20",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@11.6.0",
  "overrides": {
    "esbuild": ">=0.28.1"
  }
}
